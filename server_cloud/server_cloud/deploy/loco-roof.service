[Unit]
Description=Locomotive Roof Detection FastAPI Backend
After=network.target

[Service]
User=app
Group=app
WorkingDirectory=/opt/loco-roof/server_cloud
EnvironmentFile=/opt/loco-roof/server_cloud/.env
ExecStart=/opt/loco-roof/server_cloud/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
